#!/bin/bash

set -e

echo "[36mStarting rolling update with image v2.0...[0m"

# Apply updated deployment
kubectl apply -f messaging_app/blue_deployment.yaml

echo "[33mMonitoring rollout status...[0m"
kubectl rollout status deployment messaging-app-blue

echo "[36mHealth checking app endpoint during rollout...[0m"

APP_IP=$(kubectl get svc messaging-service -o jsonpath="{.spec.clusterIP}")
APP_PORT=80

# In a real environment, use external IP. For now, use ClusterIP and run curl inside a pod
kubectl run curl-test --rm -i --tty --image=curlimages/curl --restart=Never -- \
    /bin/sh -c "for i in \$(seq 1 10); do curl -s --max-time 2 http://$APP_IP:$APP_PORT/ || echo '[31mRequest failed[0m'; sleep 1; done"

echo "[32mRolling update health checks completed.[0m"

echo "[36mActive pods after update:[0m"
kubectl get pods -l app=messaging,version=blue -o wide

echo "[32mRolling update to v2.0 complete.[0m"
