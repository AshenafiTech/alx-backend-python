#!/bin/bash
# Script to scale Django app deployment, verify pods, load test, and monitor resource usage

set -e

DEPLOYMENT_NAME="messaging-app"
NAMESPACE="default"
REPLICAS=3

# Scale the deployment to 3 replicas
echo "Scaling $DEPLOYMENT_NAME to $REPLICAS replicas..."
kubectl scale deployment $DEPLOYMENT_NAME --replicas=$REPLICAS --namespace $NAMESPACE

# Wait for all pods to be ready
echo "Waiting for all pods to be ready..."
kubectl rollout status deployment/$DEPLOYMENT_NAME --namespace $NAMESPACE

# List all pods
echo "Listing all pods for $DEPLOYMENT_NAME:"
kubectl get pods -l app=messaging --namespace $NAMESPACE

# Find the ClusterIP and port for the service
SERVICE_NAME="messaging-service"
APP_PORT=80
CLUSTER_IP=$(kubectl get svc $SERVICE_NAME --namespace $NAMESPACE -o jsonpath='{.spec.clusterIP}')

# Run wrk load test from a temporary pod
# (Assumes wrk image is available; otherwise, use busybox/curl for a simple test)
echo "Running load test using wrk..."
kubectl run wrk-tester --rm -i --tty --image=williamyeh/wrk --restart=Never -- \
    /bin/sh -c "wrk -t2 -c50 -d10s http://$CLUSTER_IP:$APP_PORT/"

# Monitor resource usage
echo "Monitoring resource usage:"
kubectl top pods --namespace $NAMESPACE
